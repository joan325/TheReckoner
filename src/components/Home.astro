---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro'; 
import type { CollectionEntry } from 'astro:content';
import authors from '../../data/authors.json';

type PostData = CollectionEntry<'uncategorized'>;

interface PageProps {
  lastPage: number;
  data: PostData[];
  url: {
    prev?: string;
    next?: string;
    first: string;
    last: string;
  };
}

interface Props {
  page: PageProps;
  allPosts: PostData[];
  newsPosts: PostData[];
  editorialPosts: PostData[];
  lifePosts: PostData[];
  photographyPosts: PostData[];
}

const { page, allPosts, newsPosts, editorialPosts, lifePosts, photographyPosts } = Astro.props;

---


<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}

			/* Regular posts */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(100% / 3 - 2rem);
				background-color: white;
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
			}
			ul li:hover {
				box-shadow: var(--box-shadow);
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0px;
			}
			ul li a {
				display: block;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.title {
				margin: 0rem 1rem;
				color: rgb(var(--accent-dark));
				line-height: 1;
			}
			.date {
				margin: 0rem 1rem 1rem;
				color: rgb(var(--gray));
			}
            /*
			ul li a:hover h5,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
            */

			/* Contains featured + 5 more posts */
			.latest-box {
				display: grid;
				grid-template-columns: 1fr 1fr;
				width: calc(100% - 2rem);
				align-items: start;
				margin-bottom: 3rem;
                grid-auto-rows: auto;
                background-color: rgb(var(--white));
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
                border-top: 3px solid var(--accent); /* new *** */
			}
            .latest-box > ul {
                background-color: rgb(var(--white));
                all: unset;
                display: contents;
                list-style: none;
                padding: 0;
                margin: 0;
            }
			.latest-box ul {
				all: unset;
				display: contents;
                /* border: 1px solid rgb(var(--gray-light)); */

			}
			ul li.featured {
				border-radius: 0px;
				box-shadow: none;
			}
			ul li.highlighted {
				border-radius: 0px;
				box-shadow: none;
			}
			.latest-box ul li:hover {
				box-shadow: none;
			}
			.latest-box .featured {
				grid-column: 1;
				text-align: left;
                grid-row: span 5;
                width: 100%;
                list-style: none;
                height: 100%;
			}
			.latest-box .featured img {
				width: calc(100% - 2rem);
                margin: 1rem 1rem 0rem;
				border-radius: 0px;
			}

			.latest-box .highlighted {
				grid-column: 2;
				display: flex;
				align-items: center;
                width: 100%;
			}
			.latest-box .highlighted img {
				width: 15%;
				flex-shrink: 0;
                margin: 0rem 0.5rem 1rem 1rem;
			}

            ul li.highlighted a {
                display: flex;
                align-items: left;
                gap: 0rem;
                margin-top: 1rem;
            }

            .featured, .highlighted {
                outline: 1px solid rgb(var(--gray-light));
            }

            .latest-box h4 { /* new *** */
                padding: 0.6em 0.6em 0.1em 1em;
				color: rgb(var(--black));
            }

			@media (max-width: 720px) {
				ul,
				.latest-box {
					display: block;
				}
				ul li,
				.latest-box .highlighted,
				.latest-box .featured {
					width: 100%;
					text-align: center;
					margin-bottom: 1rem;
				}
				.latest-box .highlighted {
					flex-direction: column;
					align-items: center;
				}
				.latest-box .highlighted img {
					width: 80%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<!-- All posts -->
				<div class="latest-box">
                <h4>ALL POSTS</h4>
                <hr>
						<ul>
							{allPosts[0] && (
                                <li class="featured">    
									<a href={`/${allPosts[0].slug}/`}>
										<img src={allPosts[0].data.heroImage} alt="" />
										<h5 class="title">{allPosts[0].data.title}</h5>
										<p class="date">
											by {(
												authors.find(a => a.id === allPosts[0].data.author) ??
												(
													{
														id: allPosts[0].data.author,
														name: allPosts[0].data.author,
														guard: '',
														bio: 'No biography available.',
														image: '/author-images/default.jpg'
													}
												))['name']} | <FormattedDate date={allPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{allPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info"> <!-- possibly remove this? -->
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {(
													authors.find(a => a.id === post.data.author) ??
													(
														{
															id: post.data.author,
															name: post.data.author,
															guard: '',
															bio: 'No biography available.',
															image: '/author-images/default.jpg'
														}
													))['name']} | <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>

                    
				<!-- News posts -->
				<div class="latest-box">
                <h4>NEWS</h4>
                <hr>
						<ul>
							{newsPosts[0] && (
								<li class="featured">
									<a href={`/${newsPosts[0].slug}/`}>
										<img src={newsPosts[0].data.heroImage} alt="" />
										<h5 class="title">{newsPosts[0].data.title}</h5>
										<p class="date">
											by {(
												authors.find(a => a.id === newsPosts[0].data.author) ??
												(
													{
														id: newsPosts[0].data.author,
														name: newsPosts[0].data.author,
														guard: '',
														bio: 'No biography available.',
														image: '/author-images/default.jpg'
													}
												))['name']} | <FormattedDate date={newsPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{newsPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info"> <!-- possibly remove this? -->
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {(
													authors.find(a => a.id === post.data.author) ??
													(
														{
															id: post.data.author,
															name: post.data.author,
															guard: '',
															bio: 'No biography available.',
															image: '/author-images/default.jpg'
														}
													))['name']} | <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>

                    
				<!-- Editorial posts -->
				<div class="latest-box">
                <h4>EDITORIAL</h4>
                <hr>
						<ul>
							{editorialPosts[0] && (
								<li class="featured">
									<a href={`/${editorialPosts[0].slug}/`}>
										<img src={editorialPosts[0].data.heroImage} alt="" />
										<h5 class="title">{editorialPosts[0].data.title}</h5>
										<p class="date">
											by {(
												authors.find(a => a.id === editorialPosts[0].data.author) ??
												(
													{
														id: editorialPosts[0].data.author,
														name: editorialPosts[0].data.author,
														guard: '',
														bio: 'No biography available.',
														image: '/author-images/default.jpg'
													}
												))['name']} | <FormattedDate date={editorialPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{editorialPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info"> <!-- possibly remove this? -->
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {(
													authors.find(a => a.id === post.data.author) ??
													(
														{
															id: post.data.author,
															name: post.data.author,
															guard: '',
															bio: 'No biography available.',
															image: '/author-images/default.jpg'
														}
													))['name']} | <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>
				
                    
				<!-- Life posts -->
				<div class="latest-box">
                <h4>LIFE</h4>
                <hr>
						<ul>
							{lifePosts[0] && (
								<li class="featured">
									<a href={`/${lifePosts[0].slug}/`}>
										<img src={lifePosts[0].data.heroImage} alt="" />
										<h5 class="title">{lifePosts[0].data.title}</h5>
										<p class="date">
											by {(
												authors.find(a => a.id === lifePosts[0].data.author) ??
												(
													{
														id: lifePosts[0].data.author,
														name: lifePosts[0].data.author,
														guard: '',
														bio: 'No biography available.',
														image: '/author-images/default.jpg'
													}
												))['name']} | <FormattedDate date={lifePosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{lifePosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info"> <!-- possibly remove this? -->
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {(
													authors.find(a => a.id === post.data.author) ??
													(
														{
															id: post.data.author,
															name: post.data.author,
															guard: '',
															bio: 'No biography available.',
															image: '/author-images/default.jpg'
														}
													))['name']} | <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>

		</main>
		<Footer />
	</body>
</html>