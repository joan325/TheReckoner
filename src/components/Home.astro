---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro'; 
import type { CollectionEntry } from 'astro:content';
import authors from '../../data/authors.json';

type PostData = CollectionEntry<'uncategorized'>;

interface PageProps {
  lastPage: number;
  data: PostData[];
  url: {
    prev?: string;
    next?: string;
    first: string;
    last: string;
  };
}

interface Props {
  page: PageProps;
  allPosts: PostData[];
  newsPosts: PostData[];
  editorialPosts: PostData[];
  lifePosts: PostData[];
  photographyPosts: PostData[];
  featuredPosts: PostData[];
}

const { page, allPosts, newsPosts, editorialPosts, lifePosts, photographyPosts, featuredPosts } = Astro.props;

---


<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<style>
			main {
				width: 1280px;
			}

			/* Regular posts */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(100% / 3 - 2em);
				background-color: white;
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
			}
			ul li:hover {
				box-shadow: var(--box-shadow);
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0px;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			.title {
				margin: 0rem 1rem;
				color: rgb(var(--accent-dark));
				line-height: 1;
			}
			.date {
				margin: 0rem 1rem 1rem;
				color: rgb(var(--gray));
			}
            .featured .date {
                margin-bottom: 0;
                padding-bottom: 1rem;
            }
			/* Contains featured + 5 more posts */
			.latest-box:not(.all) {
				align-items: start;
				margin-bottom: 3rem;
                background-color: rgb(var(--white));
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
                border-top: 3px solid var(--accent);
			}
            .latest-box > ul {
                background-color: rgb(var(--white));
                all: unset;
                display: contents;
                list-style: none;
                padding: 0;
                margin: 0;
            }
			.latest-box ul {
				all: unset;
				display: contents;
                /* border: 1px solid rgb(var(--gray-light)); */

			}
			ul li.featured {
				border-radius: 0px;
				box-shadow: none;
                margin: 0;
			}
			ul li.highlighted {
				border-radius: 0px;
				box-shadow: none;
                margin: 0;
			}
			.latest-box ul li:hover {
				box-shadow: none;
			}
			.latest-box:not(.all) .featured {
				text-align: left;
                width: 100%;
                list-style: none;
                height: 100%;
			}
            
			.latest-box:not(.all) .featured img {
				width: calc(100% - 2rem);
                align-items: flex-start;
			}

            .latest-box .featured img {
                margin: 1rem 1rem 0rem;
				border-radius: 0px;
			}

			.latest-box .highlighted {
				display: flex;
				align-items: center;
                width: 100%;
			}
			.latest-box .highlighted img {
				width: 15%;
				flex-shrink: 0;
                margin: 0rem 0.5rem 1rem 1rem;
			}

            ul li.highlighted a {
                display: flex;
                align-items: left;
                gap: 0rem;
                margin-top: 1rem;
            }

            .featured:not(.all), .highlighted {
                outline: 1px solid rgb(var(--gray-light));
            }

            .latest-box h4 {
                padding: 0.6em 0.6em 0.1em 1em;
				color: rgb(var(--black));
            }
            .all.latest-box h4.title {
                color: var(--accent);
                padding: 0;
            }
            .all.latest-box {
                display: block;
				align-items: start;
                background-color: rgb(var(--white));
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
                border-top: 3px solid var(--accent);
                width: 100%;
                margin-bottom: 3em;
            }
            .all .featured {
                grid-row: 1;
            }

            .all.latest-box > ul {
                display: flex;
                flex-direction: row;
                scroll-snap-type: x mandatory;
                overflow-x: auto;
            }
            .all li {
                outline: none;
                flex: 0 0 auto;
				width: calc((100% - 1em) / 3);
                list-style: none;
                scroll-snap-align: start;
            }
			/* fix? */
			.all li:last-child img {
				width: calc(100% - 1em);
			}
            .all img {
                width: 100%;
				height: 192px;
				object-fit: cover;
            }
            hr {
                margin: 0;
                padding: 0;
            }

            .board-box {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1em;
				align-items: stretch;
            }

			.board-col ul {
				background: white;
				display: flex;
				flex-direction: column;
				width: 100%;
			}
			
            .box2 {
				display: flex;
                align-items: flex;
                gap: 1em;
                flex-wrap: wrap;
            }

			.box2 .feedback, .box2 .photos {
				position: inline-block;
			}

			.box2 .feedback {
				display: flex;
				height: 430px;
				width: calc(100% - 1em - 860px)
			}

			.box1 {
				display: flex;
                align-items: flex;
                gap: 1em;
                flex-wrap: wrap;
			}

			.box1 .features, .box2 .print-highlight {
				position: inline-block;
			}

			.box1 .print-highlight {
				display: flex;
				height: 430px;
				width: calc(100% - 1em - 860px)
			}

			.box1 .print-highlight img {
				width: 100%;
				object-fit: cover;
			}

			/* latest carousel */
			.carousel-wrapper {
				position: relative;
				width: 100%;
			}

			.carousel-wrapper #carouselLatest {
				scroll-behavior: smooth;
			}

			#scrollRightLatest {
				position: absolute;
				top: 50%;
				right: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
			}

			#scrollLeftLatest {
				position: absolute;
				top: 50%;
				left: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
			}

			#carouselLatest {
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				-ms-overflow-style: none;
				scrollbar-width: none;
			}

			#carouselLatest::-webkit-scrollbar {
				display: none;
			}

			/* features carousel */
			.features {
				position: relative;
                height: 430px;
                width: 860px;
                scroll-snap-type: x mandatory;
                overflow: hidden;
				display: flex;
				flex-direction: row;
				margin: 0 0 3em;
				padding: 0;
			}

			.features-track {
				display: flex;
				flex-direction: row;
				width: max-content;
				transition: transform 0.3s ease;
				flex-wrap: nowrap;
				margin: 0;
				padding: 0;
			}

			#featuresNext, #photographyNext {
				position: absolute;
				top: 50%;
				right: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
			}

			#featuresPrev, #photographyPrev {
				position: absolute;
				top: 50%;
				left: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
			}

			.features-slide {
				flex: 0 0 100%;
				position: relative;
				box-sizing: border-box;
                z-index: 1;
                height: 430px;
				width: 100%;
				margin-right: -2rem !important;
				padding: 0;
			}

			.features-slide li, .features-slide img {
                height: 430px;
				width: 100% !important;
				margin: 0;
				padding: 0;
			}
			
            .features .highlighted-info {
                color: rgb(var(--white));
                background-color: rgba(0, 0, 0, 0.5);
                margin: 0;
                padding-top: 1em;
                padding-left: 0em;
                padding-bottom: 0;
                z-index: 10;
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                font-size: 1.15em;
            }
            .features .highlighted-info p {
                color: rgb(var(--white));
            }
            .features ul li a {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
            }
            .features .title {
                font-weight: 400;
            }

			.features ul {
				width: 100% !important;
			}

			.feedback {
				width: 20%;
			}

			@media (max-width: 720px) {
				.all img {
					width: calc(100% - 2em) !important;
				}
				ul,
				.latest-box {
					display: block;
				}
				ul li,
				.latest-box .highlighted,
				.latest-box .featured {
					width: 100%;
					text-align: center;
					margin-bottom: 1rem;
				}
				.latest-box .highlighted {
					flex-direction: column;
					align-items: center;
				}
				.latest-box .highlighted img {
					width: 80%;
				}
				.board-box {
					flex-direction: column;
					gap: 0;
					width: 100%;
				}
				.board-box > .latest-box {
					width: 100%;
					margin-bottom: 1.5em;
				}
				.features ul {
					margin-bottom: 2em;
				}
				.features ul li img {
					height: 250px;
				}
				.features ul li a {
					height: 250px;
				}
				.features .highlighted-info {
					font-size: 1em;
					padding-top: 0.5em;
				}
				.latest-box .highlighted {
					display: block;
					width: 100%;
					text-align: left;
					margin-bottom: 1rem;
					border-radius: 0px;
					box-shadow: none;
				}
				.latest-box .highlighted img {
					width: calc(100% - 2rem);
					margin-right: 1rem;
					border-radius: 0px;
					border: none;
				}
				.latest-box .highlighted a {
					display: block;
					margin: 0 !important;
				}
				.latest-box .highlighted .highlighted-info {
					position: static;
					color: inherit;
					padding: 0;
					padding-bottom: 0.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>


				<div class="box1">
					<!-- Featured posts -->
					<div class="features first"> <!--for carousel-->
						<ul class="features-track">
							{featuredPosts.slice(0, 3).map((post) => (
								<li class="featured features-slide">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info">
											<h5 class="title" style="font-weight: 700;">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} /> | {post.data.tags[0]}
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button id="featuresPrev" aria-label="Scroll to previous" type="button">&lsaquo;</button>
						<button id="featuresNext" aria-label="Scroll to next" type="button">&rsaquo;</button>
					</div>

					<div class="print-highlight">
						<img src="/print-covers/cover-V12N4.png"><!-- 
						<div class="highlighted-info">
							<h5 class="title" style="font-weight: 700;">VOLUME 12 ISSUE 4</h5>
							<p class="date">Out now</p>
						</div> -->
					</div>

				</div>

				<!-- All posts -->
				<div class="all latest-box carousel-wrapper">
                <h4>LATEST</h4>
                <hr>
						<ul id="carouselLatest">
							{allPosts.slice(0, 6).map((post) => (
								<li class="featured">
									<a href={`/${post.slug}/`}>
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info">
											<h4 class="title">{post.data.title}</h4>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} /> | {post.data.tags[0]}
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button id="scrollLeftLatest" aria-label="Scroll left" type="button">&lsaquo;</button>
						<button id="scrollRightLatest" aria-label="Scroll right" type="button">&rsaquo;</button>
					</div>

                <div class="board-box">
				<!-- News posts -->
				<div class="latest-box board-col" id="news">
                <h4>NEWS</h4>
                <hr>
						<ul>
							{newsPosts[0] && (
								<li class="featured">
									<a href={`/${newsPosts[0].slug}/`}>
										<img src={newsPosts[0].data.heroImage} alt="" />
										<h5 class="title">{newsPosts[0].data.title}</h5>
										<p class="date">
											by {
											[
												(authors.find(a => a.id === newsPosts[0].data.author)?.name ?? newsPosts[0].data.author),
												...(newsPosts[0].data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
											}
											| <FormattedDate date={newsPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{newsPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>

                    
				<!-- Editorial posts -->
				<div class="latest-box board-col" id="editorial">
                <h4>EDITORIAL</h4>
                <hr>
						<ul>
							{editorialPosts[0] && (
								<li class="featured">
									<a href={`/${editorialPosts[0].slug}/`}>
										<img src={editorialPosts[0].data.heroImage} alt="" />
										<h5 class="title">{editorialPosts[0].data.title}</h5>
										<p class="date">
											by {
											[
												(authors.find(a => a.id === editorialPosts[0].data.author)?.name ?? editorialPosts[0].data.author),
												...(editorialPosts[0].data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
											}
											| <FormattedDate date={editorialPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{editorialPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>
				
                    
				<!-- Life posts -->
				<div class="latest-box board-col" id="life">
					<h4>LIFE</h4>
					<hr>
					<ul>
						{lifePosts[0] && (
							<li class="featured">
								<a href={`/${lifePosts[0].slug}/`}>
									<img src={lifePosts[0].data.heroImage} alt="" />
									<h5 class="title">{lifePosts[0].data.title}</h5>
									<p class="date">
										by {
										[
											(authors.find(a => a.id === lifePosts[0].data.author)?.name ?? lifePosts[0].data.author),
											...(lifePosts[0].data.additionalAuthors ?? []).map(id =>
												authors.find(a => a.id === id)?.name ?? id
											)
											].join(', ')
										}
										| <FormattedDate date={lifePosts[0].data.pubDate} />
									</p>
								</a>
							</li>
							)}

							{lifePosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>
                </div>

				<div class="box2">
					<div class="feedback latest-box">
						<div class="featured">
							<h4>Give us feedback!</h4>
							<hr>
							<img src="/blog-placeholder-3.jpg">	
							<div class="highlighted-info">
								<p class="date" style="color: black">Fill out our feedback form for a chance to win a gift card!</p>
							</div>
						</div>
					</div>

					<!--photography-->
					<div class="features photos"> <!--for carousel-->
						<ul class="features-track photos">
							{photographyPosts.slice(0, 3).map((post) => (
								<li class="featured features-slide">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info">
											<h5 class="title" style="font-weight: 700;">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} /> | {post.data.tags[0]}
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button id="photographyPrev" aria-label="Scroll to previous" type="button">&lsaquo;</button>
						<button id="photographyNext" aria-label="Scroll to next" type="button">&rsaquo;</button>
					</div>
				</div>

		</main>
		<Footer />
		<script>
			const leftButton = document.getElementById("scrollLeftLatest");
			const rightButton = document.getElementById("scrollRightLatest");
			const carousel = document.getElementById("carouselLatest");
			const width = carousel?.offsetWidth;

			if (rightButton && carousel && width) {
				rightButton.onclick = () => {
					carousel.scrollLeft += width / 3;
				};
			}
			if (leftButton && carousel && width) {
				leftButton.onclick = () => {
					carousel.scrollLeft -= width / 3;
				};
			}
		</script>
		<script>
			let currentIndex = 0;
			const track = document.querySelector('.first .features-track') as HTMLElement;
			const slides = document.querySelectorAll('.first .features-track .featured');

			document.getElementById('featuresNext')?.addEventListener('click', () => {
				if (currentIndex < slides.length - 1) currentIndex++;
				updateCarousel();
			});

			document.getElementById('featuresPrev')?.addEventListener('click', () => {
				if (currentIndex > 0) currentIndex--;
				updateCarousel();
			});

			function updateCarousel() {
				const offset = -currentIndex * 100;
				track.style.transform = `translateX(${offset}%)`;
			}
		</script>
		<script>
			let currentIndex2 = 0;
			const track2 = document.querySelector('.features-track.photos') as HTMLElement;
			const slides2 = document.querySelectorAll('.photos .features-track .featured');

			document.getElementById('photographyNext')?.addEventListener('click', () => {
				if (currentIndex2 < slides2.length - 1) currentIndex2++;
				updateCarousel();
			});

			document.getElementById('photographyPrev')?.addEventListener('click', () => {
				if (currentIndex2 > 0) currentIndex2--;
				updateCarousel();
			});

			function updateCarousel() {
				const offset = -currentIndex2 * 100;
				track2.style.transform = `translateX(${offset}%)`;
			}
		</script>
	</body>
</html>