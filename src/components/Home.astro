---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro'; 
import type { CollectionEntry } from 'astro:content';
import authors from '../../data/authors.json';
import { Image } from 'astro:assets';

type PostData = CollectionEntry<'uncategorized'>;

interface PageProps {
  lastPage: number;
  data: PostData[];
  url: {
    prev?: string;
    next?: string;
    first: string;
    last: string;
  };
}

interface Props {
  page: PageProps;
  allPosts: PostData[];
  newsPosts: PostData[];
  editorialPosts: PostData[];
  lifePosts: PostData[];
  photographyPosts: PostData[];
  featuredPosts: PostData[];
}

const { page, allPosts, newsPosts, editorialPosts, lifePosts, photographyPosts, featuredPosts } = Astro.props;

/* Feedback photo path */
import feedback_photo from "../assets/other/question.jpg";

/* Replace with path for latest print cover */
import latest_print_cover from "../assets/print-covers/v13n1-cover-image.jpg";

---


<!doctype html>
<html lang="en" data-pagefind-ignore="all">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<style>
			main {
				width: 1280px;
			}

			/* Regular posts */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(100% / 3 - 2em);
				background-color: white;
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
			}
			ul li:hover {
				box-shadow: var(--box-shadow);
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0px;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			.title {
				margin: 0rem 1rem;
				color: rgb(var(--accent-dark));
				line-height: 1;
			}
			.date {
				margin: 0rem 1rem 1rem;
				color: rgb(var(--gray));
			}
            .featured .date {
                margin-bottom: 0;
                padding-bottom: 1rem;
            }
			/* Contains featured + 5 more posts */
			.latest-box:not(.all) {
				align-items: start;
				margin-bottom: 3rem;
                background-color: rgb(var(--white));
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
                border-top: 4px solid var(--accent);
			}
            .latest-box > ul {
                background-color: rgb(var(--white));
                all: unset;
                display: contents;
                list-style: none;
                padding: 0;
                margin: 0;
            }
			.latest-box ul {
				all: unset;
				display: contents;
                /* border: 1px solid rgb(var(--gray-light)); */

			}
			ul li.featured {
				border-radius: 0px;
				box-shadow: none;
                margin: 0;
			}
			ul li.highlighted {
				border-radius: 0px;
				box-shadow: none;
                margin: 0;
			}
			.latest-box ul li:hover {
				box-shadow: none;
			}
			.latest-box:not(.all) .featured {
				text-align: left;
                width: 100%;
                list-style: none;
                height: 100%;
			}
            
			.latest-box:not(.all) .featured img {
				width: calc(100% - 2rem);
                align-items: flex-start;
			}

            .latest-box .featured img {
                margin: 1rem 1rem 0rem;
				border-radius: 0px;
			}

			.latest-box .highlighted {
				display: flex;
				align-items: center;
                width: 100%;
			}
			.latest-box .highlighted img {
				width: 4em;
				aspect-ratio: 3 / 2;
				flex-shrink: 0;
                margin: 0rem 0.5rem 1rem 1rem;
			}

            ul li.highlighted a {
                display: flex;
                align-items: left;
                gap: 0rem;
                padding-top: 1rem;
            }

            .featured:not(.all), .highlighted {
                border-bottom: 1px solid rgb(var(--gray-light));
            }

            .latest-box h4 {
                padding: 0.6em 0.6em 0.1em 1em;
				color: rgb(var(--black));
				background-color: rgb(var(--white));
            }
            .all.latest-box h4.title {
                color: var(--accent);
                padding: 0;
            }
            .all.latest-box {
                display: block;
				align-items: start;
                background-color: rgb(var(--white));
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
                border-top: 4px solid var(--accent);
                width: 100%;
                margin-bottom: 3em;
            }
            .all .featured {
                grid-row: 1;
            }

            .all.latest-box > ul {
                display: flex;
                flex-direction: row;
                scroll-snap-type: x mandatory;
                overflow-x: auto;
            }
            .all li {
                outline: none;
                flex: 0 0 auto;
				width: calc((100% - 1em) / 3);
                list-style: none;
                scroll-snap-align: start;
            }
			/* fix? */
			.all li:last-child img {
				width: calc(100% - 1em);
			}
            .all img {
                width: 100%;
				height: 192px;
				object-fit: cover;
            }
            hr {
                margin: 0;
                padding: 0;
            }

            .board-box {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1em;
				align-items: stretch;
            }

			.board-col ul {
				background: white;
				display: flex;
				flex-direction: column;
				width: 100%;
			}
			
            .box2 {
				display: flex;
                align-items: flex;
                gap: 1em;
                flex-wrap: wrap;
            }

			.box2 .feedback, .box2 .photos {
				position: inline-block;
			}

			.box2 .feedback {
				display: flex;
				min-height: 388.23px;
				width: 300px;
			}

			.box2 .feedback p.content {
				margin: 0rem 1rem 1rem;
				color: rgb(var(--gray));
				padding: 0 2em 2em;
			}

			.box1 {
				display: flex;
                align-items: flex;
                gap: 1em;
                flex-wrap: wrap;
			}

			.box1 .features {
				position: inline-block;
			}

			.box1 .print-highlight {
				display: flex;
				height: 388.23px;
				width: 300px;
				position: relative;
				/* min-height: 180px; */
			}

			.box1 .print-highlight img {
				width: 100%;
				object-fit: fill;
			}

			.box1 .print-highlight .highlighted-info {
				display: flex;
			}

			.box1 .print-highlight:hover .highlighted-info {
				display: block !important;
			}

			/* latest carousel */
			.carousel-wrapper {
				position: relative;
				width: 100%;
			}

			.carousel-wrapper #carouselLatest {
				scroll-behavior: smooth;
			}

			#scrollRightLatest {
				position: absolute;
				top: 50%;
				right: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
			}

			#scrollLeftLatest {
				position: absolute;
				top: 50%;
				left: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
			}

			#carouselLatest {
				overflow-x: auto;
				scroll-snap-type: x mandatory;
				-ms-overflow-style: none;
				scrollbar-width: none;
			}

			#carouselLatest::-webkit-scrollbar {
				display: none;
			}

			/* features carousel */
			.features {
				position: relative;
                height: 388.23px;
                width: calc(100% - 1em - 300px);
                scroll-snap-type: x mandatory;
                overflow: hidden;
				display: flex;
				flex-direction: row;
				margin: 0 0 3em;
				padding: 0;
			}

			.features-track {
				display: flex;
				flex-direction: row;
				width: max-content;
				transition: transform 0.3s ease;
				flex-wrap: nowrap;
				margin: 0;
				padding: 0;
			}

			#featuresNext, #photographyNext {
				position: absolute;
				top: 50%;
				right: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
				display: none;
				-webkit-animation: fadeinout 0.3s linear forwards;
				animation: fadeinout 0.3s linear forwards;
			}

			#featuresPrev, #photographyPrev {
				position: absolute;
				top: 50%;
				left: 0.8em;
				transform: translateY(-50%);
				z-index: 10;
				background: rgba(255, 255, 255, 0.7);
				border: none;
				cursor: pointer;
				font-size: 2em;
				padding: 0.25em 0.5em;
				box-shadow: var(--box-shadow);
				display: none;
				-webkit-animation: fadeinout 0.3s linear forwards;
				animation: fadeinout 0.3s linear forwards;
			}

			@-webkit-keyframes fadeinout {
				0% {
					opacity: 0;
				}
				100% {
					opacity: 1;
				}
			}

			@keyframes fadeinout {
				0% {
					opacity: 0;
				}
				100% {
					opacity: 1;
				}
			}

			.features-slide {
				flex: 0 0 100%;
				position: relative;
				box-sizing: border-box;
                z-index: 1;
                height: 388.23px;
				width: 100%;
				margin-right: -2rem !important;
				padding: 0;
			}

			.features-slide li, .features-slide img {
                height: 388.23px;
				width: 100% !important;
				margin: 0;
				padding: 0;
			}
			
            .features .highlighted-info {
                color: rgb(var(--white));
                background-color: rgba(0, 0, 0, 0.5);
                margin: 0;
				margin-bottom: -0.2em;
                padding-top: 1.2em;
                padding-left: 0em;
                padding-bottom: 0;
                z-index: 10;
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                font-size: 1.15em;
            }

			.print-highlight .highlighted-info {
                color: rgb(var(--white));
                background-color: rgba(0, 0, 0, 0.5);
                margin: 0;
                padding-top: 1em;
                padding-left: 0em;
                padding-bottom: 0;
                z-index: 10;
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                font-size: 1.15em;
            }
			
            .features .highlighted-info p, .print-highlight .highlighted-info p {
                color: rgb(var(--white));
            }
            .features ul li a {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
            }
            .features .title {
                font-weight: 400;
            }

			.features ul {
				width: 100% !important;
			}
			.board-box .see-more-button {
				display: none;
				margin-inline: auto;
				margin-top: 2em;
				margin-bottom: 2em;
				background-color: var(--accent-dark);
				text-decoration: none;
				border: none;
				padding: 0.75em 1.5em;
			}
			.board-box .see-more-button a {
				color: rgb(var(--white));
				text-decoration: none;
				font-size: 1.2em;
			}


			@media (max-width: 720px) {
				main {
					width: 75%;
				}
				.all img {
					width: calc(100% - 2em) !important;
				}
				ul,
				.latest-box {
					display: block;
				}
				ul li,
				.latest-box .highlighted,
				.latest-box .featured {
					width: 100%;
				}
				.latest-box .highlighted {
					flex-direction: column;
					align-items: center;
				}
				.board-box .highlighted:nth-child(n+3) {
					display: none;
				}
				.board-box .see-more-button {
					display: block;
				}
				.latest-box .highlighted img {
					width: 80%;
				}
				.board-box {
					flex-direction: column;
					display: flex;
					width: 100%;
					align-items: stretch;
				}
				.board-box > .latest-box {
					width: 100%;
				}
				.features {
					width: 100%;
				}
				.features .highlighted-info {
					font-size: 1em;
				}
				.latest-box .highlighted {
					display: block;
					width: 100%;
					text-align: left;
					border-radius: 0px;
					box-shadow: none;
				}
				.latest-box .highlighted img {
					width: calc(100% - 2rem);
					margin-right: 1rem;
					border-radius: 0px;
					border: none;
					margin-bottom: 0;
				}
				.latest-box .highlighted a {
					display: block;
					margin: 0 !important;
				}
				.latest-box .highlighted .highlighted-info {
					position: static;
					color: inherit;
					padding: 0;
				}
				.box1 .print-highlight {
					height: 100%;
					margin-inline: auto;
					margin-bottom: 4em;
				}
				.box1 .print-highlight .highlighted-info {
					display: block;
					margin-bottom: 0.4em;
				}
				.box2 .feedback {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>


				<div class="box1">
					<!-- Featured posts -->
					<div class="features first"> <!--for carousel-->
						<ul class="features-track">
							{featuredPosts.slice(0, 3).map((post, index) => (
								<li class="featured features-slide">
									<a href={`/${post.slug}/`}>
										<Image
										src={post.data.heroImage}
										alt={post.data.heroImageAlt}
										loading={index === 1 ? "lazy" : "eager"}
										/>
										<div class="highlighted-info">
											<p class="title" style="font-weight: 700; color: white;">{post.data.title}</p>
											<p class="date" style="color: white;">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} /> | {post.data.tags[0]}
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button id="featuresPrev" aria-label="Scroll to previous" type="button">&lsaquo;</button>
						<button id="featuresNext" aria-label="Scroll to next" type="button">&rsaquo;</button>
					</div>

					<div class="print-highlight">
						<a href="/prints">
							<Image src={latest_print_cover} alt="Print Cover" loading="eager"/>
							<div class="highlighted-info">
								<p class="title" style="font-weight: 700; color: white;">NEW PRINT</p>
								<p class="date" style="color: white; display: flex;">CLICK TO READ</p>
							</div>
						</a>
					</div>

				</div>

				<!-- All posts -->
				<div class="all latest-box carousel-wrapper">
                <h4>LATEST</h4>
                <hr>
						<ul id="carouselLatest">
							{allPosts.slice(0, 6).map((post) => (
								<li class="featured">
									<a href={`/${post.slug}/`}>
										<Image src={post.data.heroImage} alt={post.data.heroImageAlt} loading="eager"/>
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} /> | {post.data.tags[0]}
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button id="scrollLeftLatest" aria-label="Scroll left" type="button">&lsaquo;</button>
						<button id="scrollRightLatest" aria-label="Scroll right" type="button">&rsaquo;</button>
					</div>

                <div class="board-box">
				<!-- News posts -->
				<div class="latest-box board-col" id="news">
                <h4>NEWS</h4>
                <hr>
						<ul>
							{newsPosts[0] && ( /* FIX */
								<li class="featured">
									<a href={`/${newsPosts[0].slug}/`}>
										<Image src={newsPosts[0].data.heroImage} alt={newsPosts[0].data.heroImageAlt} />
										<h5 class="title">{newsPosts[0].data.title}</h5>
										<p class="date">
											by {
											[
												(authors.find(a => a.id === newsPosts[0].data.author)?.name ?? newsPosts[0].data.author),
												...(newsPosts[0].data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
											}
											| <FormattedDate date={newsPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{newsPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<Image src={post.data.heroImage} alt={post.data.heroImageAlt} />
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button class="see-more-button"><a href="/news">More News</a></button>
					</div>

                    
				<!-- Editorial posts -->
				<div class="latest-box board-col" id="editorial">
                <h4>EDITORIAL</h4>
                <hr>
						<ul>
							{editorialPosts[0] && (
								<li class="featured">
									<a href={`/${editorialPosts[0].slug}/`}>
										<Image src={editorialPosts[0].data.heroImage} alt={editorialPosts[0].data.heroImageAlt} />
										<h5 class="title">{editorialPosts[0].data.title}</h5>
										<p class="date">
											by {
											[
												(authors.find(a => a.id === editorialPosts[0].data.author)?.name ?? editorialPosts[0].data.author),
												...(editorialPosts[0].data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
											}
											| <FormattedDate date={editorialPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{editorialPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<Image src={post.data.heroImage} alt={post.data.heroImageAlt} />
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button class="see-more-button"><a href="/editorial">More Editorial</a></button>
					</div>
				
                    
				<!-- Life posts -->
				<div class="latest-box board-col" id="life">
					<h4>LIFE</h4>
					<hr>
					<ul>
						{lifePosts[0] && (
							<li class="featured">
								<a href={`/${lifePosts[0].slug}/`}>
									<Image src={lifePosts[0].data.heroImage} alt={lifePosts[0].data.heroImageAlt} />
									<h5 class="title">{lifePosts[0].data.title}</h5>
									<p class="date">
										by {
										[
											(authors.find(a => a.id === lifePosts[0].data.author)?.name ?? lifePosts[0].data.author),
											...(lifePosts[0].data.additionalAuthors ?? []).map(id =>
												authors.find(a => a.id === id)?.name ?? id
											)
											].join(', ')
										}
										| <FormattedDate date={lifePosts[0].data.pubDate} />
									</p>
								</a>
							</li>
							)}

							{lifePosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<Image src={post.data.heroImage} alt={post.data.heroImageAlt} />
										<div class="highlighted-info">
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button class="see-more-button"><a href="/life">More Life</a></button>
					</div>
                </div>

				<div class="box2">
					<div class="feedback latest-box">
						<div class="featured">
							<h4>FEEDBACK</h4>
							<hr>
							<Image src={feedback_photo} alt=""/>	
							<div>
								<p class="content" style="color: black">Fill out our <a href="https://forms.gle/DdxJNSKzzvCsJuvX8">feedback form</a> for a chance to win a prize!</p>
							</div>
						</div>
					</div>

					<!--photography-->
					<div class="features photos"> <!--for carousel-->
						<ul class="features-track photos">
							{photographyPosts.slice(0, 3).map((post) => (
								<li class="featured features-slide">
									<a href={`/${post.slug}/`}>
									
										<Image src={post.data.heroImage} alt={post.data.heroImageAlt} />
										<div class="highlighted-info">
											<h5 class="title" style="font-weight: 700;">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
						<button id="photographyPrev" aria-label="Scroll to previous" type="button">&lsaquo;</button>
						<button id="photographyNext" aria-label="Scroll to next" type="button">&rsaquo;</button>
					</div>
				</div>

		</main>
		<Footer />
		<script>
			const leftButton = document.getElementById("scrollLeftLatest");
			const rightButton = document.getElementById("scrollRightLatest");
			const carousel = document.getElementById("carouselLatest");
			const width = carousel?.offsetWidth;

			var offset = 0;
			if (carousel) {
				if (window.innerWidth < 720) {
					offset = carousel.offsetWidth;
				} else {
					offset = carousel.offsetWidth / 3;
				}
			}

			if (rightButton && carousel && offset) {
				rightButton.onclick = () => {
					carousel.scrollLeft += offset;
				};
			}
			if (leftButton && carousel && offset) {
				leftButton.onclick = () => {
					carousel.scrollLeft -= offset;
				};
			}
		</script>
		<script>
			function initCarousel({
				containerSelector,
				trackSelector,
				slideSelector,
				nextId,
				prevId,
			}: {
				containerSelector: string;
				trackSelector: string;
				slideSelector: string;
				nextId: string;
				prevId: string;
			}) {
				let currentIndex = 0;

				const container = document.querySelector(containerSelector);
				const track = container?.querySelector(trackSelector) as HTMLElement;
				const slides = container?.querySelectorAll(slideSelector);
				const next = document.getElementById(nextId);
				const prev = document.getElementById(prevId);

				if (!container || !track || !slides || slides.length === 0) return;

				function updateCarousel() {
					const offset = -currentIndex * 100;
					track.style.transform = `translateX(${offset}%)`;

					if (next && prev && slides) {
						next.style.display = currentIndex < slides.length - 1 ? 'block' : 'none';
						prev.style.display = currentIndex > 0 ? 'block' : 'none';
					}
				}

				next?.addEventListener('click', () => {
					if (currentIndex < slides.length - 1) {
						currentIndex++;
						updateCarousel();
					}
				});

				prev?.addEventListener('click', () => {
					if (currentIndex > 0) {
						currentIndex--;
						updateCarousel();
					}
				});

				function hideArrows() {
					if (next) next.style.display = 'none';
					if (prev) prev.style.display = 'none';
				}
				

				// Runs once
				if (window.innerWidth < 720) {
					updateCarousel();
				} else {
					container.addEventListener('mouseover', updateCarousel);
					container.addEventListener('mouseout', hideArrows);
				}

				let resizeTimer: ReturnType<typeof setTimeout> | undefined;

				function handleResize(): void {
					if (window.innerWidth < 720) {
						container?.removeEventListener('mouseout', hideArrows);
						container?.removeEventListener('mouseover', updateCarousel);

						container?.addEventListener('mouseover', updateCarousel);
					} else {
						container?.addEventListener('mouseover', updateCarousel);
						container?.addEventListener('mouseout', hideArrows);
					}
				}

				window.addEventListener('resize', () => {
					clearTimeout(resizeTimer);
					resizeTimer = setTimeout(() => {
						handleResize();
					}, 250);
				});

				hideArrows();
				updateCarousel();
			}

			// Initialize both carousels
			function setupCarousels() {
				initCarousel({
					containerSelector: '.features.first',
					trackSelector: '.features-track',
					slideSelector: '.features-track .featured',
					nextId: 'featuresNext',
					prevId: 'featuresPrev',
				});

				initCarousel({
					containerSelector: '.features.photos',
					trackSelector: '.features-track',
					slideSelector: '.features-track .featured',
					nextId: 'photographyNext',
					prevId: 'photographyPrev',
				});
			}

			setupCarousels();
			
			window.addEventListener('resize', () => {
				setupCarousels();
			});

		</script>
		
		</body>
</html>
