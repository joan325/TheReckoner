---
interface Props {
  length: number;
  currentUrl: string;
  currentPage: number;
  firstUrl: string;
  prevUrl?: string;
  nextUrl?: string;
  lastUrl: string;
}

const { length, currentUrl, currentPage, firstUrl, prevUrl, nextUrl, lastUrl } = Astro.props;

const paginationList = Array.from({ length }, (_, i) => i + 1);
---

<style>
    .pagination {
        max-width: fit-content;
        margin-inline: auto;
        margin-top: 1em;
    }

    .pagination__link {
        display: inline-block;
        padding: 0em 0.5em;
        margin: 0em 0.25em;
        border: 1px solid var(--accent-dark);
        background: rgb(var(--white));
        color: rgb(var(--accent));
        text-decoration: none;
    }

    .pagination__link.disabled {
        opacity: 0.5;
        pointer-events: none;
    }

    .pagination__link.active {
        font-weight: bold;
        border: 1px solid var(--accent);
        background-color: rgb(var(--white));
    }
</style>  

<nav aria-label="Pages" class="pagination pagination-default">
  {!prevUrl ? (
    <span class="pagination__link disabled">
      &laquo;
    </span>
  ) : (
    <a href={firstUrl} class="pagination__link">
      &laquo;
    </a>
  )}

  {prevUrl ? (
    <a href={prevUrl} class="pagination__link">
      &lsaquo;
    </a>
  ) : (
    <span class="pagination__link disabled">
      &lsaquo;
    </span>
  )}

  {paginationList.map((num) => {
  if (currentPage === num) {
    return (
      <span class="pagination__link disabled active" aria-current="page">
        {num}
      </span>
    );
  } else if (Math.abs(currentPage - num) < 4) {
    return (
        <a href={`${firstUrl}/${num}`} class="pagination__link">
            {num}
        </a>
    );
  } else {
    return (<span></span>);
  }
})}

  {!nextUrl ? (
    <span class="pagination__link disabled">
      &rsaquo;
    </span>
  ) : (
    <a href={nextUrl} class="pagination__link">
      &rsaquo;
    </a>
  )}

  {!nextUrl ? (
    <span class="pagination__link disabled">
      &raquo;
    </span>
  ) : (
    <a href={lastUrl} class="pagination__link">
      &raquo;
    </a>
  )}
</nav>
