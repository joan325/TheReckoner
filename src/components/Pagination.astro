---
interface Props {
  length: number;
  currentUrl: string;
  currentPage: number;
  firstUrl: string;
  prevUrl?: string;
  nextUrl?: string;
  lastUrl: string;
}

const { length, currentUrl, currentPage, firstUrl, prevUrl, nextUrl, lastUrl } = Astro.props;

const paginationList = Array.from({ length }, (_, i) => i + 1);
---

<style>
    .pagination__link {
        display: inline-block;
        padding: 0.5em;
        margin: 0 0.25em;
        border: 1px solid rgb(var(--gray-dark));
        background: rgb(var(--white));
        color: rgb(var(--black));
        text-decoration: none;
    }

    .pagination__link.disabled {
        opacity: 0.5;
        pointer-events: none;
    }

    .pagination__link.active {
        font-weight: bold;
        border-color: rgb(var(--accent));
        background-color: rgb(var(--gray-light));
    }
</style>

<nav aria-label="Blog pages" class="pagination pagination-default">
  {firstUrl == currentUrl ? (
    <span class="pagination__link disabled">
      &laquo;
    </span>
  ) : (
    <a href={firstUrl} class="pagination__link">
      &laquo;
    </a>
  )}

  {prevUrl ? (
    <a href={prevUrl} class="pagination__link">
      &lsaquo;
    </a>
  ) : (
    <span class="pagination__link disabled">
      &lsaquo;
    </span>
  )}

  {paginationList.map((num) =>
    currentPage === num ? (
      <span class="pagination__link disabled active" aria-current="page">
        {num}
      </span>
    ) : (
      <a href={`${firstUrl}${num === 1 ? "" : "/" + num}`} class="pagination__link">
        {num}
      </a>
    )
  )}

  {!nextUrl ? (
    <span class="pagination__link disabled">
      &rsaquo;
    </span>
  ) : (
    <a href={nextUrl} class="pagination__link">
      &rsaquo;
    </a>
  )}

  {lastUrl == currentUrl ? (
    <span class="pagination__link disabled">
      &raquo;
    </span>
  ) : (
    <a href={lastUrl} class="pagination__link">
      &raquo;
    </a>
  )}
</nav>
