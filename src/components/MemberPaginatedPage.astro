---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro'; 
import Pagination from '../components/Pagination.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import authors from '../../data/authors.json';
import { Image } from 'astro:assets';

type PostData = CollectionEntry<'uncategorized'>;

interface PageProps {
  currentPage: number;
  lastPage: number;
  data: PostData[];
  url: {
    current: string;
    prev?: string;
    next?: string;
    first: string;
    last: string;
  };
}

interface Props {
  name: string;
  page: PageProps;
  allPosts: PostData[];
}

const { name, page, allPosts } = Astro.props;

const authorObj = authors.find(a => a.id === name) ?? {
  id: name,
  name: name,
  guard: '',
  bio: 'No biography available.',
  image: '/author-images/default.jpg'
};


// authors.find(a => a.id === post.data.author)['name'] ?? (post.data.author);
---


<!doctype html>
<html lang="en" data-pagefind-ignore="all">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}

			/* Regular posts */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(100% / 3.0 - 2rem);
				background-color: white;
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
			}
			ul li:hover {
				box-shadow: var(--box-shadow);
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0px;
				height: 160px;
				width: auto;
				min-width: 100%;
			}
			ul li a {
				display: block;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.title {
				margin: 0rem 1rem;
				color: rgb(var(--accent-dark));
				line-height: 1;
			}
			.date {
				margin: 0rem 1rem 1rem;
				color: rgb(var(--gray));
			}
            /*
			ul li a:hover h5,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
            */
			.author-box {
				display: flex;
			}
			.author-img {
				width: auto;
				height: 12em;
				margin: 1em 1em 1.5em;
			}
			.author-info {
				padding: 0em 2em 2em 2em;
			}
			.author-box-full { /* FIX SPACING OF POSTS (on both this and PaginatedPage), fix mobile vers, make sure is centred + aligned w author box*/
				width: calc(100% - 2.3em);
				margin: 2em 0em;
				background-color: rgb(var(--white));
			}
			.author-box-full h5 {
				padding: 1em 1em 0.3em;
				color: rgb(var(--black));
			}

			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 0 1em;
				}
				h2 {
					margin-top: 2rem;
					margin-bottom: -2rem;
				}
				.date {
					padding-bottom: 1rem;
				}
				ul,
				.latest-box {
					display: block;
					background: none;
					margin-top: 2rem;
					width: 100%;
					grid-template-columns: none;
					grid-auto-rows: none;
				}
				ul li,
				.latest-box .highlighted,
				.latest-box .featured {
					width: 100%;
					text-align: center;
					margin-bottom: 1rem;
				}
				.latest-box img {
					margin: 0 !important;
					padding: 0 !important;
				}
				.latest-box .featured,
				.latest-box .highlighted {
					all: unset;
					display: block;
					width: 100%;
					text-align: center;
					margin-bottom: 1rem;
					background-color: white;
					border-radius: 3px;
					box-shadow: var(--box-shadow-2);
				}
				.latest-box .featured img,
				.latest-box .highlighted img {
					width: 100%;
					margin-bottom: 0.5rem;
					max-height: 200px;
					height: auto;
				}
				.latest-box .featured a,
				.latest-box .highlighted a {
					display: block;
					text-decoration: none;
					transition: 0.2s ease;
					padding: 0;
				}
				.latest-box .featured .highlighted-info,
				.latest-box .highlighted .highlighted-info {
					all: unset;
				}
				.author-box {
					flex-direction: column;
					align-items: center;
					text-align: center;
				}
				.author-img {
					width: auto;
					height: 8em;
					margin: 1em 0;
				}
				.author-box-full {
					width: 100%;
					margin: 1.5em 0;
				}
				.mobile-latest {
					background-color: rgb(var(--white));
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h2>Posts by {name}:</h2>
				
				<br>

				<!-- All posts -->
				<ul>
					{page.data.map((post) => (
						<li>
							<a href={`/${post.slug}/`}>
								<Image src={post.data.heroImage} alt={post.data.heroImageAlt} />
								
								<h5 class="title">{post.data.title}</h5>
								<p class="date">
									by {
									[
									(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
									...(post.data.additionalAuthors ?? []).map(id =>
										authors.find(a => a.id === id)?.name ?? id
									)
									].join(', ')
									}
									| <FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>

				<div class="author-box-full"> <!-- make this a component? -->
					<h5>ABOUT THE AUTHOR</h5>
					<hr>
					<div class="author-box">
						<img src=`${authorObj['image']}` class="author-img">
						<div class="author-info">
							<p><strong>{authorObj['name']}</strong></p>
							<p>{authorObj['bio']}</p>
						</div>
					</div>
				</div>

				<Pagination 
						length={page.lastPage}
						currentUrl={page.url.current}
						currentPage={page.currentPage}
						firstUrl={page.url.first}
						prevUrl={page.url.prev}
						nextUrl={page.url.next}
						lastUrl={page.url.last}
					/>

			</section>
		</main>
		<Footer />
	</body>
</html>