---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import { Image } from 'astro:assets'
import logo_image from '../assets/other/logo.png';

---

<header>
	<nav class="topnav" id="myTopnav">
		<link rel="stylesheet"  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
		<h2 class="logo"><a href="/" aria-label="Reckoner Home"><Image src={logo_image} style="height: 50px; width: auto;" alt="Reckoner Logo" loading="eager"></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/news">News</HeaderLink>
			<HeaderLink href="/editorial">Editorial</HeaderLink>
			<HeaderLink href="/life">Life</HeaderLink>
			<HeaderLink href="/photography">Photography</HeaderLink>
			<HeaderLink href="/uncategorized">All</HeaderLink>
			<HeaderLink href="/prints">Prints</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<form method="get" action="/search">
			<div class="search-bar">
				<input type="search" name="q" placeholder="Search">
				<input type="submit" value="" aria-label="Search">
			</div>
		</form>
		<a href="javascript:void(0);" class="icon" onclick="myFunction()">
    		<i class="fa fa-bars"></i>
  		</a>
		<div class="social-links">
			<a href="https://www.instagram.com/mgci.reckoner" target="_blank">
				<span class="sr-only">Follow us on Instagram</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16"
					><path
						fill="currentColor"
  						d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"
					></path></svg>
			</a>
			<a href="https://linktr.ee/thereckoner" target="_blank">
				<span class="sr-only">Linktree</span>
				<svg viewBox="0 0 256 256" aria-hidden="true" width="16" height="16"
					><path
						fill="currentColor"
						d="M136 160v72a8 8 0 0 1-16 0v-72a8 8 0 0 1 16 0m72-64h-60.69l42.35-42.34a8 8 0 0 0-11.32-11.32L136 84.69V24a8 8 0 0 0-16 0v60.69L77.66 42.34a8 8 0 0 0-11.32 11.32L108.69 96H48a8 8 0 0 0 0 16h60.69l-42.35 42.34a8 8 0 0 0 11.32 11.32L128 115.31l50.34 50.35a8 8 0 0 0 11.32-11.32L147.31 112H208a8 8 0 0 0 0-16"
					></path></svg>
			</a>
		</div>
	</nav>

</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1.5em 0.5em;
		color: var(--gray);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	nav a.hover {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	nav .logo a {
		padding: 0;
		padding-top: 0.5em;
	}
	nav a.icon {
		display: none;
	}
	.social-links,
	.social-links a {
		display: flex;
		color: rgb(var(--gray-dark));
	}
	.social-links a:hover {
		display: flex;
		color: rgb(var(--accent-dark));
	}
	input {
		font-family: "Open Sans", sans-serif;
	}
	input[type=submit] {
		background-image: url(/searchicon.png);
		background-position: 0px 0px;
		background-repeat: no-repeat;
		background-size: contain;
		width: 30px;
		background-color: transparent;
		border: none;
		border-radius: 0.25em;
		margin-left: 0.25em;
		cursor: pointer;
	}
	input[type=search]:focus {
		/* width: 100%; */
		border: 2px solid var(--accent);
	}
	input[type=search]::placeholder {
		font-style: italic;
	}
	.search-bar:has(input[type=search]:focus) { /* FIX */
		width: 100%;
	}
	input[type=search] {
		padding-left: 10px;
		background-color: white;
		width: 200px;
		border: 2px solid rgb(var(--gray-light));
		border-radius: 0.5em;
	}
	@media (max-width: 973px) {
		.social-links {
			display: none;
		}
		nav {
			padding: 0;
		}
		.internal-links {
			display: flex;
			justify-content: center;
			flex-direction: column;
			align-items: center;
			gap: 0.5em;
			margin-top: 1em;
			margin-inline: auto;
		}
		.internal-links a {
			padding: 0.5em 0.75em;
			font-size: 0.9em;
			border-bottom: 2px solid transparent;
		}
		nav a {
			display: none;
		}
		nav h2 a {
			display: flex;
			width: 100%;
		}
		nav a.icon {
			float: right;
			display: block;
			padding-top: 1.5em !important;
			padding-bottom: 1.5em !important;
		}
		nav.responsive {
			position: relative;
		}
		nav.responsive a.icon {
			position: absolute;
			right: 0;
			top: 0;
		}
		nav.responsive .internal-links {
			padding-top: 1em;
			padding-bottom: 1em;
		}
		nav.responsive a {
			float: none;
			display: block;
			text-align: left;
		}
		nav.responsive .social-links {
			display: flex;
			position: absolute;
			right: 3em;
			top: 0.3em;
		}
		nav.responsive .social-links a {
			display: block;
		}
		nav.responsive .logo {
			position: absolute;
			display: absolute;
			left: 0;
			top: 0.1em;
		}
		nav.responsive form {
			display: none;
		}

		h2 {
			margin-bottom: 0.5em;
		}
		.search-bar {
			margin-right: 1.5em;
		}
	}
	@media (max-width: 720px) {
		nav.responsive .logo img {
			margin-top: 15px;
		}
		nav.responsive .logo a {
			padding-top: 0;
		}
	}
	@media (max-width: 600px) {
		.search-bar input[type=search] {
			display: none;
		}
	}
	@media (max-width: 300px) {
		nav .logo img {
			object-fit: contain;
		}
		form {
			display: none;
		}
		nav a.icon {
			padding-top: 1.5em;
			padding-bottom: 1.5em;
		}
	}
</style>
<script>
	var x = document.getElementById("myTopnav");
	x?.addEventListener('click', () => {
		if (x) {
			if (x.className === "topnav") {
				x.className += " responsive";
			} else {
				x.className = "topnav";
			}
		}
	});
</script>

