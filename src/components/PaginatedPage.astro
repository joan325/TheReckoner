---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro'; 
import Pagination from '../components/Pagination.astro';
import type { CollectionEntry } from 'astro:content';
import authors from '../../data/authors.json';

type PostData = CollectionEntry<'uncategorized'>;

interface PageProps {
  currentPage: number;
  lastPage: number;
  data: PostData[];
  url: {
    current: string;
    prev?: string;
    next?: string;
    first: string;
    last: string;
  };
}

interface Props {
  category: string;
  page: PageProps;
  allPosts: PostData[];
}

const { category, page, allPosts } = Astro.props;




---


<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}

			/* Regular posts */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(100% / 3 - 2rem);
				background-color: white;
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
			}
			ul li:hover {
				box-shadow: var(--box-shadow);
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0px;
				max-height: 200px;
				width: 100%;
				height: auto;
			}
			ul li a {
				display: block;
				text-decoration: none;
				transition: 0.2s ease;
			}
			.title {
				margin: 0rem 1rem;
				color: rgb(var(--accent-dark));
				line-height: 1;
			}
			.date {
				margin: 0rem 1rem 1rem;
				color: rgb(var(--gray));
			}

			/* Contains featured + 5 more posts */
			.latest-box {
				display: grid;
				grid-template-columns: 1fr 1fr;
				width: calc(100% - 2rem);
				align-items: start;
				margin-bottom: 3rem;
                grid-auto-rows: auto;
                background-color: rgb(var(--white));
				border-radius: 3px;
				box-shadow: var(--box-shadow-2);
                border-top: 3px solid var(--accent);
			}
            .latest-box > ul {
                background-color: rgb(var(--white));
                all: unset;
                display: contents;
                list-style: none;
                padding: 0;
                margin: 0;
            }
			.latest-box ul {
				all: unset;
				display: contents;
                /* border: 1px solid rgb(var(--gray-light)); */

			}
			ul li.featured {
				border-radius: 0px;
				box-shadow: none;
			}
			ul li.highlighted {
				border-radius: 0px;
				box-shadow: none;
			}
			.latest-box ul li:hover {
				box-shadow: none;
			}
			.latest-box .featured {
				grid-column: 1;
				text-align: left;
                grid-row: span 5;
                width: 100%;
                list-style: none;
                height: 100%;
			}
			.latest-box .featured img {
				width: calc(100% - 2rem);
                margin: 1rem 1rem 0rem;
				border-radius: 0px;
			}

			.latest-box .highlighted {
				grid-column: 2;
				display: flex;
				align-items: center;
                width: 100%;
			}
			.latest-box .highlighted img {
				width: 4em;
				height: 3em;
				flex-shrink: 0;
                margin: 0rem 0.5rem 1rem 1rem;
			}

            ul li.highlighted a {
                display: flex;
                align-items: left;
                gap: 0rem;
                margin-top: 1rem;
            }

            .featured, .highlighted {
                outline: 1px solid rgb(var(--gray-light));
            }

            .latest-box h4 { /* new *** */
                padding: 0.6em 0.6em 0.1em 1em;
				color: rgb(var(--black));
            }

			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 0 1em;
				}
				.date {
					padding-bottom: 1rem;
				}
				ul,
				.latest-box {
					display: block;
					background: none;
					margin-top: 2rem;
					width: 100%;
					grid-template-columns: none;
					grid-auto-rows: none;
				}
				ul li,
				.latest-box .highlighted,
				.latest-box .featured {
					width: 100%;
					text-align: center;
					margin-bottom: 1rem;
				}
				.latest-box img {
					margin: 0 !important;
					padding: 0 !important;
				}
				.latest-box .featured,
				.latest-box .highlighted {
					all: unset;
					display: block;
					width: 100%;
					text-align: center;
					margin-bottom: 1rem;
					background-color: white;
					border-radius: 3px;
					box-shadow: var(--box-shadow-2);
				}
				.latest-box .featured img,
				.latest-box .highlighted img {
					width: 100%;
					margin-bottom: 0.5rem;
					max-height: 200px;
					height: auto;
					border-radius: 0px;
				}
				.latest-box .featured a,
				.latest-box .highlighted a {
					display: block;
					text-decoration: none;
					transition: 0.2s ease;
					padding: 0;
				}
				.latest-box .featured .highlighted-info,
				.latest-box .highlighted .highlighted-info {
					all: unset;
				}
				.mobile-latest {
					background-color: rgb(var(--white));
					margin-bottom: 1em;
				}
				.mobile-latest h4 {
					padding-bottom: 0.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<!-- First 6 posts (featured + highlighted) -->
				{page.currentPage === 1 && (
					<div class="latest-box">
						<div class="mobile-latest">
							<h4>{category.toUpperCase()}</h4>
						</div>
					
						<ul>
							{allPosts[0] && (
								<li class="featured">
									<a href={`/${allPosts[0].slug}/`}>
										<img src={allPosts[0].data.heroImage} alt="" />
										<h5 class="title">{allPosts[0].data.title}</h5>
										<p class="date">
											by {
											[
											(authors.find(a => a.id === allPosts[0].data.author)?.name ?? allPosts[0].data.author),
											...(allPosts[0].data.additionalAuthors ?? []).map(id =>
												authors.find(a => a.id === id)?.name ?? id
											)
											].join(', ')
											}
											| <FormattedDate date={allPosts[0].data.pubDate} />
										</p>
									</a>
								</li>
							)}

							{allPosts.slice(1, 6).map((post) => (
								<li class="highlighted">
									<a href={`/${post.slug}/`}>
									
										<img src={post.data.heroImage} alt="" />
										<div class="highlighted-info"> <!-- possibly remove this? -->
											<h5 class="title">{post.data.title}</h5>
											<p class="date">
												by {
												[
												(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
												...(post.data.additionalAuthors ?? []).map(id =>
													authors.find(a => a.id === id)?.name ?? id
												)
												].join(', ')
												}
												| <FormattedDate date={post.data.pubDate} />
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</div>
				)}

				<!-- Rest of posts -->
				<ul>
					{page.data.map((post) => (
						<li>
							<a href={`/${post.slug}/`}>
								<img src={post.data.heroImage} alt="" />
								
								<h5 class="title">{post.data.title}</h5>
								<p class="date">
									by {
									[
									(authors.find(a => a.id === post.data.author)?.name ?? post.data.author),
									...(post.data.additionalAuthors ?? []).map(id =>
										authors.find(a => a.id === id)?.name ?? id
									)
									].join(', ')
									}
									| <FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>

				<Pagination 
						length={page.lastPage}
						currentUrl={page.url.current}
						currentPage={page.currentPage}
						firstUrl={page.url.first}
						prevUrl={page.url.prev}
						nextUrl={page.url.next}
						lastUrl={page.url.last}
					/>

			</section>
		</main>
		<Footer />
	</body>
</html>