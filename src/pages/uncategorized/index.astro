---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(100% / 3 - 2rem);
				background-color: white;
			}
			ul li.highlighted {
				width: 50%;
				grid-column: 2;
				display: flex;
				align-items: center;
				gap: 1rem;
				height: auto;
				flex-shrink: 0;
			}
			ul li.highlighted img {
				width: 20%;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}

			ul li.featured {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
				grid-column: 1;
			}
			ul li.featured img {
				width: 50%;
			}
			ul li.featured .title {
				/* font-size: 2.369rem; */
			}

			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
				margin: 0.4rem 1rem 0rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				margin: 0rem 1rem 1rem;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			.latest-box {
				background-color: rgb(var(--white));
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 2rem;
				width: 100%;
			}

			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li,
				ul li.highlighted {
					width: 100%;
					text-align: center;
				}
				ul li.featured {
					margin-bottom: 0;
				}
				ul li.featured .title {
					font-size: 1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					<div class="latest-box">
					<!-- First post -->
					{posts[0] && (
						<li class="featured">
							<a href={`/uncategorized/${posts[0].id}/`}>
								<img src={posts[0].data.heroImage} alt="" />
								<h4 class="title">{posts[0].data.title}</h4>
								<p class="date">
									by {posts[0].data.author} | <FormattedDate date={posts[0].data.pubDate} />
								</p>
							</a>
						</li>
					)}

					<!-- Posts 2–4 -->
					{posts.slice(1, 4).map((post) => (
						<li class="highlighted">
							<a href={`/uncategorized/${post.id}/`}>
								<img src={post.data.heroImage} alt="" />
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									by {post.data.author} | <FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
					</div>
					<!-- Rest -->
					{posts.slice(4).map((post) => (
						<li>
							<a href={`/uncategorized/${post.id}/`}>
								<img src={post.data.heroImage} alt="" />
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									by {post.data.author} | <FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
