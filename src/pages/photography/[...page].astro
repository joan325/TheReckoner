---
import PaginatedPage from '../../components/PaginatedPage.astro';
import { getCollection } from 'astro:content';

const allPostsSorted = (await getCollection('photography')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

export async function getStaticPaths({ paginate }: { paginate: any }) {

	const allPostsSorted = (await getCollection('photography')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	
	// Skip highlighted posts showed on page 1
	const rest = allPostsSorted.slice(6);

	return paginate(rest, { pageSize: 15 });
}

const { page } = Astro.props;
---

<PaginatedPage page={page} category="photography" allPosts={allPostsSorted} />
