---
import MemberPaginatedPage from '../../../components/MemberPaginatedPage.astro';
import { getCollection } from 'astro:content';
import authors from '../../../../data/authors.json';

const { page } = Astro.props;
const { member, page: pageParam } = Astro.params;

if (pageParam === "1") {
  return Astro.redirect(`/member/${member}/`, 301);
}

console.log('page param:', Astro.params.page, Array.isArray(Astro.params.page));


const allPosts = await getCollection('uncategorized', ({ data }) => {
  return data.author === member;
});

const allPostsSorted = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const allPosts = await getCollection('uncategorized');

  // Step 1: Gather all unique member IDs
  const memberSet = new Set<string>();

  for (const post of allPosts) {
    memberSet.add(post.data.author);
    const additional = post.data.additionalAuthors ?? [];
    additional.forEach((id: string) => memberSet.add(id));
  }

  for (const author of authors) {
    memberSet.add(author.id);
  }

  const uniqueMembers = [...memberSet];
  const allPaginatedPaths = [];

  for (const member of uniqueMembers) {
    const postsByMember = allPosts.filter(post =>
      post.data.author === member || (post.data.additionalAuthors ?? []).includes(member)
    );

    const postsSorted = postsByMember.sort(
      (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );

    const paginatedPaths = paginate(postsSorted, {
      pageSize: 15,
      params: { member },
    });

    allPaginatedPaths.push(...paginatedPaths);

    allPaginatedPaths.push({
      params: { member, page: "1" },
    });
  }

  return allPaginatedPaths;
}
---

<MemberPaginatedPage page={page} name={member} allPosts={allPostsSorted} />