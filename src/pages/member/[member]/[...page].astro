---
import MemberPaginatedPage from '../../../components/MemberPaginatedPage.astro';
import { getCollection } from 'astro:content';
import Redirect1 from '../../../components/Redirect-1.astro';
// export const prerender = false;

const { page } = Astro.props;
const { member, page: pageParam } = Astro.params;

let redirectUrl = '';
let redirect = false;

console.log('0');
if (Array.isArray(pageParam) && pageParam[0] === "1") {
	redirectUrl = `members/${member}`;
	redirect = true;
	console.log(`redirect: ${member}`);
}

const allPosts = await getCollection('uncategorized', ({ data }) => {
	return data.author === member;
});

const allPostsSorted = allPosts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

export async function getStaticPaths({ paginate }: { paginate: any }) {
	const allPosts = await getCollection('uncategorized');

	const uniqueMembers = [...new Set(allPosts.map(post => post.data.author))];

	const allPaginatedPaths = [];

	for (const member of uniqueMembers) {
		const postsByMember = allPosts.filter(post => post.data.author === member);

		const postsSorted = postsByMember.sort(
			(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
		);

		const paginatedPaths = paginate(postsSorted, {
			pageSize: 15,
			params: { member },
		});

		allPaginatedPaths.push(...paginatedPaths);
		
		allPaginatedPaths.push({
      		params: { member, page: "1" },
    	});
	}

	

	return allPaginatedPaths;
}
---

{redirect ? (
	<Redirect1 category={redirectUrl}></Redirect1>
	) : (
		<MemberPaginatedPage page={page} name={member} allPosts={allPostsSorted} />
	)
}
