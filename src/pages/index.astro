---
import Home from '../components/Home.astro';
import { getCollection } from 'astro:content';


// All
const allPostsSorted = (await getCollection('uncategorized')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);


// News
const newsPosts = await getCollection('uncategorized', ({ data }) => {
	return data.tags[0] === "News"
});
const newsPostsSorted = (newsPosts).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Editorial
const editorialPosts = await getCollection('uncategorized', ({ data }) => {
	return data.tags[0] === "Editorial"
});
const editorialPostsSorted = (editorialPosts).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Life
const lifePosts = await getCollection('uncategorized', ({ data }) => {
	return data.tags[0] === "Life"
});
const lifePostsSorted = (lifePosts).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Photography
const photographyPosts = await getCollection('uncategorized', ({ data }) => {
	return data.tags[0] === "Photography"
});
const photographyPostsSorted = (photographyPosts).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

	
// remove below later
export async function getStaticPaths({ paginate }: { paginate: any }) {

	const allPostsSorted = (await getCollection('uncategorized')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);
	
	// Skip highlighted posts showed on page 1
	const rest = allPostsSorted.slice(6);

	return paginate(rest, { pageSize: 15 });
}

const { page } = Astro.props;
---

<Home page={page} allPosts={allPostsSorted} newsPosts={newsPostsSorted} editorialPosts={editorialPostsSorted} lifePosts={lifePostsSorted} photographyPosts={photographyPostsSorted} />
