---
import Layout from "../layouts/About.astro";
import guards from "../../data/guards.json";
import { Image } from "astro:assets";
import heroImage from "../assets/placeholders/blog-placeholder-about.jpg";
---

<style>
  li a p {
    margin: 0;
  }
</style>


<Layout
  title="Who We Are"
  author="Fifteenth Guard Staff"
  description=""
  pubDate={new Date("August 13 2025")}
  heroImage={heroImage}
  heroImageAlt="Placeholder image with a smiling face"
  featured={false}
  imageType="Placeholder"
  tags={new Array("Uncategorized")}
>
  <p>
    <!-- (Fifteenth Guard description) -->
  </p>
  <p>
    <!-- (General description) -->
  </p>

  <p>
    Below are the members of The Reckoner's Fifteenth Guard. Previous
    guards can be found here:
  </p>
  <ul>
    {
      guards.map(({ guard_name, guard_title }) => (
        (guard_title !== "Fifteenth Guard") && (<li> <!--change to const current in import -->
          <a href={`/about/${guard_name}`}>
            <p style="display: inline;">{guard_title}</p>
          </a>
        </li>)
      ))
    }
  </ul>
</Layout>
