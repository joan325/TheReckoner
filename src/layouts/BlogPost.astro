---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, author, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.article-box {
				width: 85%;
				margin: 2em auto;
				background-color: rgb(var(--white));
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto 1.5em;
				border-radius: 0px; /* previously 12px */
				box-shadow: var(--box-shadow);
			}
			.prose {
				max-width: calc(100% - 8em);
				margin: auto;
				padding: 4em;
				color: rgb(var(--black));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				font-weight: normal;
			}
			.date {
				margin-bottom: 1em;
				color: rgb(var(--black));
			}
			.author {
				margin-bottom: 0.5em;
				color: rgb(var(--black));
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<div class="article-box"><article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="author"> <!--update name-->
							By: {author} | <FormattedDate date={pubDate} />
						</div>
						<div class="date">
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<br> <!--fix-->
				<div class="hero-image">
					{heroImage && <img width={680} height={340} src={heroImage} alt="" />} <!--1020x510-->
				</div>
						<hr />
					</div>
					<slot />
				</div>
			</article></div>
		</main>
		<Footer />
	</body>
</html>
