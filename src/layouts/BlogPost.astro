---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import authors from '../../data/authors.json';

type Props = CollectionEntry<'uncategorized'>['data'];

const { title, description, author, pubDate, updatedDate, heroImage } = Astro.props;

const authorObj = authors.find(a => a.id === author) ?? {
  id: author,
  name: author,
  guard: '',
  bio: 'No biography available.',
  image: '/author-images/default.jpg'
};

const authorName = authorObj['name'];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.article-box {
				width: 85%;
				margin: 2em auto;
				background-color: rgb(var(--white));
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto 1.5em;
				border-radius: 0px; /* previously 12px */
				box-shadow: var(--box-shadow);
			}
			.prose {
				max-width: calc(100% - 8em);
				margin: auto;
				padding: 4em;
				color: rgb(var(--black));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
				/* font-weight: normal; */
			}
			.date {
				margin-bottom: 1em;
				color: rgb(var(--black));
			}
			.author {
				margin-bottom: 0.5em;
				color: rgb(var(--black));
			}
			.last-updated-on {
				font-style: italic;
			}
			.author-box {
				display: flex;
			}
			.author-img {
				width: auto;
				height: 12em;
				margin: 1em 1em 1.5em;
			}
			.author-info {
				padding: 0em 2em 0em 1em;
			}
			.author-box-full {
				width: 85%;
				margin: 2em auto;
				background-color: rgb(var(--white));
			}
			.author-box-full h5 {
				padding: 1em 1em 0.3em;
				color: rgb(var(--black));
			}

			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 0 0em;
				}
				.article-box {
					width: 100%;
					margin: 1em 0;
				}
				.prose {
					max-width: 100%;
					padding: 2em 1em;
					
				}
				.hero-image img {
					width: 100%;
					height: auto;
				}
				.title h1 {
					font-size: 1.5em;
				}
				.author-box {
					flex-direction: column;
					align-items: center;
					text-align: center;
				}
				.author-img {
					width: auto;
					height: 8em;
					margin: 1em 0;
				}
				.author-info {
					padding: 0 1em;
				}
				.author-box-full {
					width: 100%;
					margin: 1.5em 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			
			<div class="article-box"><article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="author"> <!--update name-->
							By: {authorName} | <FormattedDate date={pubDate} />
						</div>
						<div class="date">
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<br> <!--fix-->
				<div class="hero-image">
					{heroImage && <img width={680} height={340} src={heroImage} alt="" />} <!--1020x510-->
				</div>
						<hr />
					</div>
					<slot />
				</div>
			</article></div>
			<div class="author-box-full"> <!-- make this a component? -->
				<h5>ABOUT THE AUTHOR</h5>
				<hr>
				<div class="author-box">
					<img src=`${authorObj['image']}` class="author-img">
					<div class="author-info">
						<a href=`/member/${authorObj['id']}` style="text-decoration: none;"><p><strong>{authorName}</strong></p></a>
						<p>{authorObj['bio']}</p>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
